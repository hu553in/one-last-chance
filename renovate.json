{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>hu553in/common-things//presets/renovate/bun",
    "github>hu553in/common-things//presets/renovate/go"
  ],
  "enabledManagers": ["bun", "custom.regex", "github-actions", "gomod"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track gomobile build tool",
      "managerFilePatterns": ["/^scripts/build-runtime\\.sh$/"],
      "matchStrings": ["gomobile_version=\"(?<currentValue>[^\"\\r\\n]+)\""],
      "datasourceTemplate": "go",
      "depNameTemplate": "golang.org/x/mobile",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Keep Node typings on the declared runtime major",
      "matchManagers": ["bun"],
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Preserve the Expo-compatible xmldom line",
      "matchManagers": ["bun"],
      "matchPackageNames": ["@xmldom/xmldom"],
      "allowedVersions": "<0.9.0"
    },
    {
      "description": "Group Expo SDK updates",
      "matchManagers": ["bun"],
      "matchPackageNames": [
        "@bacons/apple-targets",
        "@expo/**",
        "@react-native/**",
        "@types/react",
        "eslint-config-expo",
        "expo",
        "expo-*",
        "react",
        "react-native",
        "react-native-*"
      ],
      "groupName": "Expo SDK"
    },
    {
      "description": "Disable automatic Expo SDK major updates",
      "matchManagers": ["bun"],
      "matchPackageNames": [
        "@bacons/apple-targets",
        "@expo/**",
        "eslint-config-expo",
        "expo",
        "expo-*"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Disable automatic React and React Native core updates",
      "matchManagers": ["bun"],
      "matchPackageNames": ["@react-native/**", "react", "react-native"],
      "enabled": false
    },
    {
      "description": "Disable automatic React Native companion minor and major updates",
      "matchManagers": ["bun"],
      "matchPackageNames": ["@types/react", "react-native-*"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      "description": "Preserve the compatible olcRTC revision",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/openlibrecommunity/olcrtc"],
      "enabled": false
    }
  ]
}
