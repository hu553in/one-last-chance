{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>hu553in/common-things//presets/renovate/bun",
    "github>hu553in/common-things//presets/renovate/go",
    "helpers:disableTypesNodeMajor"
  ],
  "enabledManagers": ["bun", "custom.regex", "github-actions", "gomod"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Tun2SocksKit podspec releases",
      "managerFilePatterns": ["/^targets/networkpackettunnel/pods\\.rb$/"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>EbrahimTahernejad/Tun2SocksKit)/(?<currentValue>[^/'\"\\s]+)/Tun2SocksKit\\.podspec"
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "description": "Disable automatic TypeScript major updates",
      "matchManagers": ["bun"],
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Keep xmldom compatible with Expo",
      "matchManagers": ["bun"],
      "matchPackageNames": ["@xmldom/xmldom"],
      "allowedVersions": "<0.9.0"
    },
    {
      "description": "Group Expo SDK updates",
      "matchManagers": ["bun"],
      "matchPackageNames": [
        "@bacons/apple-targets",
        "@expo/**",
        "@react-native/**",
        "@types/react",
        "eslint-config-expo",
        "expo",
        "expo-*",
        "react",
        "react-native",
        "react-native-*"
      ],
      "groupName": "Expo SDK"
    },
    {
      "description": "Disable automatic Expo SDK major updates",
      "matchManagers": ["bun"],
      "matchPackageNames": [
        "@bacons/apple-targets",
        "@expo/**",
        "eslint-config-expo",
        "expo",
        "expo-*"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Disable automatic React and React Native core updates",
      "matchManagers": ["bun"],
      "matchPackageNames": ["@react-native/**", "react", "react-native"],
      "enabled": false
    },
    {
      "description": "Disable automatic React Native companion minor and major updates",
      "matchManagers": ["bun"],
      "matchPackageNames": ["@types/react", "react-native-*"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      "description": "Keep WebRTC compatible with olcRTC's transport/v4 API",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/pion/webrtc/v4"],
      "allowedVersions": "<4.2.21"
    },
    {
      "description": "Keep ICE compatible with WebRTC's transport/v4 API",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/pion/ice/v4"],
      "allowedVersions": "<4.4.3"
    },
    {
      "description": "Keep SRTP compatible with WebRTC's transport/v4 API",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/pion/srtp/v3"],
      "allowedVersions": "<3.0.16"
    },
    {
      "description": "Keep TURN compatible with ICE's transport/v4 API",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/pion/turn/v5"],
      "allowedVersions": "<5.1.2"
    },
    {
      "description": "Keep LiveKit protocol compatible with owenlivekit's TransferSIPParticipant API",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/livekit/protocol"],
      "allowedVersions": "<1.51.0"
    },
    {
      "description": "Disable automatic olcRTC updates to preserve the shared client and server revision",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/openlibrecommunity/olcrtc"],
      "enabled": false
    }
  ]
}
